# Example environment for LOCAL DEVELOPMENT ONLY.
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# In the shipped application the API key is NOT read from a file: the Rust shell
# reads it from the macOS Keychain and places it in the backend child's
# environment on spawn. This file exists so the backend and the verification
# script can be run standalone during development.

# Required. Your OpenAI API key. Never commit a real one.
OPENAI_API_KEY=sk-replace-me

# Optional. Pins the realtime transcription WebSocket URL.
# Run `make verify-openai` to discover the value that works for your project,
# then set it here. See docs/openai-verification.md §2.
# JLT_OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription

# Optional. Path to the Swift audio helper if it is not in the default location.
# JLT_AUDIO_HELPER=/absolute/path/to/teams-audio-tap

# Optional. Backend log level: DEBUG, INFO, WARNING, ERROR.
# Note: no level ever logs meeting content.
JLT_LOG_LEVEL=INFO
