{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Japanese Live Translator",
  "version": "0.1.0",
  "mainBinaryName": "Japanese Live Translator",
  "identifier": "com.jlt.japanese-live-translator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Japanese Live Translator",
        "width": 560,
        "height": 620,
        "minWidth": 320,
        "minHeight": 240,
        "alwaysOnTop": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../../backend/dist/jlt-backend": "jlt-backend",
      "../../audio-capture/.build/release/teams-audio-tap": "teams-audio-tap"
    }
  }
}
