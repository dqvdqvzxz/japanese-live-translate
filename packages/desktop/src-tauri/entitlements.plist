<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The backend is a child process of this app. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required to spawn the Python backend and the Swift audio helper. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Outbound only, to api.openai.com. No server socket beyond loopback. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- No keychain-access-groups entitlement.
       It is only needed to SHARE a keychain item between several apps, which
       this app does not do: it reads and writes its own item in the default
       keychain, which needs no entitlement. Worse, the $(AppIdentifierPrefix)
       placeholder cannot be resolved by an ad-hoc signature, so including it
       made every ad-hoc-signed build get SIGKILLed by the system on launch. -->
</dict>
</plist>
